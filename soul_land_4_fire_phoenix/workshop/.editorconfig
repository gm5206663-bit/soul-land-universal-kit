root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.py]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
# Markdown hard-breaks and recovered evidence may intentionally contain trailing spaces.
trim_trailing_whitespace = false
